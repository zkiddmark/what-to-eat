@page "/login"
@model WhatToEatApp.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logga in</title>
    <base href="~/" />
    <link href="css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div class="d-flex flex-column align-items-center mt-3">
        <div class="border rounded col-sm-9 col-lg-6 p-3">
            <h3 class="text-muted mb-3">Logga in</h3>

            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label for="emailInput" class="form-label">E-post</label>
                    <input type="email" class="form-control" id="emailInput" asp-for="Input.Email"
                        autocomplete="username" required aria-describedby="emailHelp" />
                    <span class="text-danger" asp-validation-for="Input.Email"></span>
                </div>
                <div class="mb-3">
                    <label for="passwordInput" class="form-label">Lösenord</label>
                    <input type="password" class="form-control" id="passwordInput" asp-for="Input.Password"
                        autocomplete="current-password" required />
                    <span class="text-danger" asp-validation-for="Input.Password"></span>
                </div>
                <button type="submit" class="btn btn-secondary w-100" data-submit>Logga in</button>
            </form>

            <p class="mt-3 mb-0 text-muted">
                Har du inget konto? <a asp-page="/Register">Skapa konto</a>
            </p>
        </div>
    </div>
    <script src="js/submitOnce.js" asp-append-version="true"></script>
</body>

</html>
