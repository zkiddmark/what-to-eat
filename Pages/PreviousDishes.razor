@inject IDishService DishService;
@page "/previousDishes"

<PageTitle>Alla rätter</PageTitle>
<div class="app-shell">
    <h1 class="text-center me-3">Alla rätter</h1>
    <div class="d-flex flex-column align-items-center">
        <PaginatorComponent OnPageChangedEvent="(page) => OnPageChanged(page)" TotalItems="@DishesCount" />
        <div class="row">
            @foreach (var dishDto in Dishes)
            {
                <div class="d-flex justify-content-center col-md-6 mb-5">
                    <PreviousDishComponent DishDto=@dishDto OnScheduleNextTime="(e) => OnScheduleNextTimeHandler(e)"
                    OnDeleteDish="(dish) => OnDeleteDishHandler(dish)" OnVoteChanged="@ReloadCurrentPageAsync"
                    OnDishUpdated="@ReloadCurrentPageAsync" />
                </div>
            }
        </div>
    </div>
</div>

@if (PendingPlan is not null)
{
    <ConfirmDialogComponent Title="Ersätta dagens rätt?"
        Question="@($"{PendingPlan.Day.ToSwedish()} har redan {PendingPlan.ExistingTitle} i din vecka. Ersätta den med {PendingPlan.NewTitle}?")"
        ConfirmText="Ersätt" Result="@OnReplaceConfirmed" />
}

@if (PlanError is not null)
{
    <div class="app-shell">
        <div class="alert alert-danger" role="alert">@PlanError</div>
    </div>
}

@code
{
    private int _skip = 0;
    private int _take = 10;

    private List<DishDto> Dishes { get; set; } = new();
    private PlanRequest? PendingPlan { get; set; }
    private string? PlanError { get; set; }

    private class PlanRequest
    {
        public Days Day { get; set; }
        public Guid DishId { get; set; }
        public string ExistingTitle { get; set; } = string.Empty;
        public string NewTitle { get; set; } = string.Empty;
    }
    private int DishesCount { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDishesAsync(_skip, _take);
    }

    private async Task LoadDishesAsync(int skip, int take)
    {
        Dishes.AddRange(await DishService.GetAllDishes(skip, take));
        DishesCount = await DishService.DishesCount();
    }

    /// <summary>Hämtar om sidan så att snittet speglar den röst som just sparats.</summary>
    private async Task ReloadCurrentPageAsync()
    {
        Dishes.Clear();
        await LoadDishesAsync(_skip, _take);
    }

    public async Task OnPageChanged(PaginatorEventArgs args)
    {
        Dishes.Clear();
        _skip = args.Skip;
        _take = args.Take;
        Dishes.AddRange(await DishService.GetAllDishes(args.Skip, args.Take));
    }

    /// <summary>
    /// Planerar in rätten i MIN vecka. Går via SetPlanAsync, inte UpdateDishAsync — att
    /// planera kräver inte ägarskap, och den gamla vägen skrev dessutom över den rätt som
    /// råkade ligga på dagen, oavsett vems den var.
    /// </summary>
    public async Task OnScheduleNextTimeHandler(PreviousDishEventArgs e)
    {
        PlanError = null;

        // Ligger redan något på min dag ska jag få veta det innan det byts ut.
        var existing = await DishService.GetTodaysDish(e.Day);
        if (existing is not null && existing.DishId != e.DishId)
        {
            PendingPlan = new PlanRequest
            {
                Day = e.Day,
                DishId = e.DishId,
                ExistingTitle = existing.Title,
                NewTitle = Dishes.FirstOrDefault(x => x.DishId == e.DishId)?.Title ?? "rätten",
            };
            return;
        }

        await ApplyPlanAsync(e.Day, e.DishId);
    }

    private async Task OnReplaceConfirmed(bool confirmed)
    {
        var request = PendingPlan;
        PendingPlan = null;
        if (!confirmed || request is null)
        {
            // Avbryt lämnar dagen orörd.
            return;
        }
        await ApplyPlanAsync(request.Day, request.DishId);
    }

    private async Task ApplyPlanAsync(Days day, Guid dishId)
    {
        try
        {
            await DishService.SetPlanAsync(dishId, day);
        }
        catch (Exception)
        {
            PlanError = "Rätten kunde inte planeras in. Din vecka är oförändrad.";
            return;
        }

        // Läs om först efter att planeringen gått igenom.
        await ReloadCurrentPageAsync();
    }

    public async Task OnDeleteDishHandler(DishDto dishDto)
    {
        await DishService.DeleteDishAsync(dishDto);
        Dishes.Clear();
        await LoadDishesAsync(_skip, _take);
    }
}