@page "/byt-losenord"
@model WhatToEatApp.Pages.ForcedPasswordChangeModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="sv">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Välj ett nytt lösenord</title>
    <base href="~/" />
    <link href="css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div class="d-flex flex-column align-items-center mt-3">
        <div class="border rounded col-sm-9 col-lg-6 p-3">
            <h3 class="text-muted mb-3">Välj ett nytt lösenord</h3>
            <p>
                En administratör har satt ett tillfälligt lösenord åt dig. Välj ett eget för
                att fortsätta.
            </p>

            @if (Model.ErrorMessage is not null)
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }

            <form method="post">
                <div class="mb-3">
                    <label for="newPasswordInput" class="form-label">Nytt lösenord</label>
                    <input type="password" class="form-control" id="newPasswordInput"
                        asp-for="Input.NewPassword" autocomplete="new-password" required
                        aria-describedby="newPasswordHelp" />
                    <div id="newPasswordHelp" class="form-text">Minst 12 tecken.</div>
                    <span class="text-danger" asp-validation-for="Input.NewPassword"></span>
                </div>
                <div class="mb-3">
                    <label for="confirmPasswordInput" class="form-label">Upprepa nytt lösenord</label>
                    <input type="password" class="form-control" id="confirmPasswordInput"
                        asp-for="Input.ConfirmPassword" autocomplete="new-password" required />
                    <span class="text-danger" asp-validation-for="Input.ConfirmPassword"></span>
                </div>
                <button type="submit" class="btn btn-secondary w-100" data-submit>Spara och fortsätt</button>
            </form>

            @* Enda vägen bort från sidan. Ingen meny, ingen "hoppa över". *@
            <form method="post" action="/logout" class="mt-3">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-link p-0 text-muted">Logga ut</button>
            </form>
        </div>
    </div>
    <script src="js/submitOnce.js" asp-append-version="true"></script>
</body>

</html>
