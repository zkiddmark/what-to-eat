@page "/"
<div class="app-shell">
    <div class="d-flex flex-column align-items-center">
        <h1 class="me-3">What to eat</h1>
        <div class="row">
            @foreach (var day in Enum.GetValues<Days>())
            {
                <div class="d-flex justify-content-center col-md-6 my-3">
                    <DayCard Day=day />
                </div>
            }
        </div>
    </div>
</div>
