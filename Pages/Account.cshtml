@page "/konto"
@model WhatToEatApp.Pages.AccountModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Mitt konto";
}
<h1 class="mb-1">Mitt konto</h1>
<p class="text-muted">@Model.Email · @Model.Alias</p>

<h2 class="mb-3">Byt lösenord</h2>

@if (Model.PasswordChanged)
{
    <div class="alert alert-success" role="alert">
        Lösenordet är bytt. Du är kvar inloggad här — eventuella inloggningar i
        andra webbläsare har loggats ut.
    </div>
}
else if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
}

<form method="post">
    <div class="mb-3">
        <label for="currentPasswordInput" class="form-label">Nuvarande lösenord</label>
        <input type="password" class="form-control" id="currentPasswordInput"
            asp-for="Input.CurrentPassword" autocomplete="current-password" required />
        <span class="text-danger" asp-validation-for="Input.CurrentPassword"></span>
    </div>
    <div class="mb-3">
        <label for="newPasswordInput" class="form-label">Nytt lösenord</label>
        <input type="password" class="form-control" id="newPasswordInput"
            asp-for="Input.NewPassword" autocomplete="new-password" required
            aria-describedby="newPasswordHelp" />
        <div id="newPasswordHelp" class="form-text">Minst 12 tecken.</div>
        <span class="text-danger" asp-validation-for="Input.NewPassword"></span>
    </div>
    <div class="mb-3">
        <label for="confirmPasswordInput" class="form-label">Upprepa nytt lösenord</label>
        <input type="password" class="form-control" id="confirmPasswordInput"
            asp-for="Input.ConfirmPassword" autocomplete="new-password" required />
        <span class="text-danger" asp-validation-for="Input.ConfirmPassword"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100" data-submit>Byt lösenord</button>
</form>

<p class="mt-3 mb-0 text-muted">
    <a href="~/">Tillbaka till appen</a>
</p>
