@page "/register"
@model WhatToEatApp.Pages.RegisterModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Skapa konto";
}
<h1 class="mb-3">Skapa konto</h1>

@if (Model.Registered)
{
    <p class="mb-3">
        Kontot är skapat och väntar på godkännande. Du får tillgång till appen
        så snart någon har godkänt det.
    </p>
    <p class="mb-0 text-muted">
        <a asp-page="/Login">Tillbaka till logga in</a>
    </p>
}
else
{
    @if (Model.ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="mb-3">
            <label for="aliasInput" class="form-label">Namn</label>
            <input type="text" class="form-control" id="aliasInput" asp-for="Input.Alias"
                autocomplete="nickname" required />
            <span class="text-danger" asp-validation-for="Input.Alias"></span>
        </div>
        <div class="mb-3">
            <label for="emailInput" class="form-label">E-post</label>
            <input type="email" class="form-control" id="emailInput" asp-for="Input.Email"
                autocomplete="username" required />
            <span class="text-danger" asp-validation-for="Input.Email"></span>
        </div>
        <div class="mb-3">
            <label for="passwordInput" class="form-label">Lösenord</label>
            <input type="password" class="form-control" id="passwordInput" asp-for="Input.Password"
                autocomplete="new-password" required aria-describedby="passwordHelp" />
            <div id="passwordHelp" class="form-text">Minst 12 tecken.</div>
            <span class="text-danger" asp-validation-for="Input.Password"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100" data-submit>Skapa konto</button>
    </form>

    <p class="mt-3 mb-0 text-muted">
        <a asp-page="/Login">Tillbaka till logga in</a>
    </p>
}
