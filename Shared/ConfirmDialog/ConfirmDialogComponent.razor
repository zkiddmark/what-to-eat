<div class="modal modal-backdrop bg-dark bg-opacity-75" style="display: block;" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">@Title</h3>
                <button type="button" class="btn-close" aria-label="Stäng"
                    @onclick="() => Result.InvokeAsync(false)"></button>
            </div>
            <div class="modal-body">
                <p>@Question</p>
            </div>
            <div class="modal-footer">
                @* Knappen säger vad som händer, inte "Ja". Är handlingen destruktiv bär den
                   farofärgen — förut satt primärfärgen på avbryt, alltså tvärtom. *@
                <button type="button" class="btn @(Destructive ? "btn-danger" : "btn-primary")"
                    @onclick="() => Result.InvokeAsync(true)">@ConfirmText</button>
                <button type="button" class="btn btn-secondary" @onclick="() => Result.InvokeAsync(false)">@CancelText</button>
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public string Title { get; set; } = string.Empty;
    [Parameter]
    public string Question { get; set; } = string.Empty;
    /// <summary>Verbet på bekräfta-knappen. Säger vad som händer: "Ta bort", "Avslå".</summary>
    [Parameter]
    public string ConfirmText { get; set; } = "Bekräfta";

    [Parameter]
    public string CancelText { get; set; } = "Avbryt";

    /// <summary>Destruktiv handling: bekräfta-knappen bär farofärgen i stället för primär.</summary>
    [Parameter]
    public bool Destructive { get; set; }

    [Parameter]
    public EventCallback<bool> Result { get; set; }
}