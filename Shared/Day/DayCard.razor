@inject IDishService DishService;
@inject ILogger<DayCard> Logger;

<div class="card border-0 w-100 dish-card">
    <div class="row g-0 justify-content-center border rounded">
        @if (TodaysDish != null)
        {
            <ResolveImageComponent DishDto=@TodaysDish />
        }
        <div class="card-body">
            <div class="row">
                <div class="col-sm-12 d-flex">
                    <h2 class="card-title mb-4">@Day.ToString() <span class="fs-6 text">@(TodaysDish != null ?
                            $"({TodaysDish?.When.Date.ToShortDateString()})" : string.Empty)</span></h2>
                    @if (TodaysDish is not null)
                    {
                        <AverageScoreComponent AverageScore="@TodaysDish!.AverageScore" VoteCount="@TodaysDish!.VoteCount" />
                    }
                </div>
                <div class="row mb-4">
                    <div class="col-sm-8 d-flex align-items-center">
                        <h3 class="card-subtitle">@(TodaysDish?.Title ?? "No dish, go ahead and plan one!")
                        </h3>
                    </div>
                    @if (!string.IsNullOrEmpty(TodaysDish?.RecipeUrl))
                    {
                        <div class="col-sm-4 d-flex align-items-center">
                            <a href="@TodaysDish?.RecipeUrl" target="_blank">
                                Link to recipe<i class="bi bi-link-45deg"></i>
                            </a>
                        </div>
                    }

                </div>
                @if (TodaysDish is not null)
                {
                    <div class="col-sm-12 mb-2">
                        <small class="text-muted">av @TodaysDish.OwnerAlias</small>
                    </div>
                    <div class="col-sm-12 mb-2">
                        <MyVoteComponent DishDto="TodaysDish" VoteChanged="@ReloadDishAsync" />
                    </div>
                }
                <div class="col-sm-10">
                    <p class="card-text">@(TodaysDish?.Notes)</p>
                </div>
                <IngredientsComponent DishDto="@TodaysDish"/>
            </div>
            <div class="row mt-3">
                @if (TodaysDish is null || TodaysDish.CanEdit)
                {
                    <div class="col-xs-12 col-lg-10 mt-2">
                        <button class="btn btn-secondary w-100" @onclick="@OpenModal">@(TodaysDish != null ? "Update the dish" :
                            "Add a dish")</button>
                    </div>
                }
                @if (TodaysDish is not null && TodaysDish.CanEdit)
                {
                    <div class="col-xs-12 col-lg-2 mt-2">
                        <button class="btn btn-danger w-100" @onclick="@RemoveTodaysDish">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@if (ShowModal == true)
{
    <DayCardModal Dish="@TodaysDish" Day="@Day" OnCloseEvent="@CloseModal" HandleOnSaveEvent="@HandleOnSave"
        SaveError="@ErrorMessage" />
}

@code
{
    [Parameter]
    public Days Day { get; set; }

    private DishDto? TodaysDish { get; set; }

    private bool ShowModal { get; set; }

    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        TodaysDish = await DishService.GetTodaysDish(Day);
    }

    public async Task HandleOnSave((DishDto dish, bool newDish) data)
    {
        ErrorMessage = null;
        try
        {
            switch (data.newDish)
            {
                case true:
                    await DishService.AddDishAsync(data.dish);
                    break;
                default:
                    await DishService.UpdateDishAsync(data.dish);
                    break;
            }
        }
        catch (ForbiddenException)
        {
            ErrorMessage = "Du får bara ändra dina egna rätter.";
            // Modalen har redan skrivit sina fält in i DTO:n. Hämta om rätten, annars visar
            // kortet bakom modalen ändringar som aldrig sparades.
            TodaysDish = await DishService.GetTodaysDish(Day);
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Kunde inte spara rätten för {Day}.", Day);
            ErrorMessage = "Rätten kunde inte sparas. Ingenting har ändrats — försök igen.";
            TodaysDish = await DishService.GetTodaysDish(Day);
            return;
        }

        TodaysDish = await DishService.GetTodaysDish(Day);
        // Modalen stänger inte sig själv längre — den stängs här, och bara när det gick bra.
        ShowModal = false;
    }

    private async Task RemoveTodaysDish()
    {
        if (TodaysDish is not null)
        {
            TodaysDish.When = DateTimeOffset.MinValue;
            await DishService.UpdateDishAsync(TodaysDish);
            TodaysDish = null; // set to null since it has been "deleted".
        }
    }

    /// <summary>Hämtar om rätten så att snittet speglar den röst som just sparats.</summary>
    private async Task ReloadDishAsync()
    {
        TodaysDish = await DishService.GetTodaysDish(Day);
    }

    private void CloseModal(bool show)
    {
        ShowModal = !show;
        StateHasChanged();
    }

    private void OpenModal()
    {
        ErrorMessage = null;
        ShowModal = true;
        StateHasChanged();
    }

}