<div class="modal modal-backdrop bg-dark bg-opacity-75" style="display: block;" id="DayCardModal" tabindex="-1"
  data-bs-backdrop="static" aria-labelledby="DayCardModalLabel" aria-hidden="false" area-modal="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title" id="DayCardModalLabel">@ModalHeaderText</h3>
        <button type="button" class="btn-close" aria-label="Stäng"
          @onclick="() => OnCloseEvent.InvokeAsync(true)"></button>
      </div>
      <div class="modal-body">
        @if (SaveError is not null)
        {
          <div class="alert alert-danger" role="alert">@SaveError</div>
        }
        <div class="input-group ">
          <span class="input-group-text col-4 col-sm-3 text-wrap">Rättens namn</span>
          <input class="form-control col-8 col-sm-9" type="text" @bind="TitleInput" />
        </div>
        @if (_titleError is not null)
        {
          <div class="text-danger mt-1" role="alert">@_titleError</div>
        }
        <div class="list-group mt-3">
          <AddIngredientsComponent IngredientList="IngredientList" OnAddIngredientEvent="OnAddIngredientHandler" />
        </div>
        <div class="input-group mt-3">
          <span class="input-group-text col-4 col-sm-3">Anteckningar</span>
          <textarea class="form-control col-8 col-sm-9" placeholder="Skriv några steg eller klistra in en länk"
            @bind="NotesTextArea"></textarea>
        </div>
        <div class="input-group my-3">
          <span class="input-group-text text-wrap col-4 col-sm-3">Länk till receptet</span>
          <input type="text" class="form-control col-8 col-sm-9" @bind="RecipeUrlInput">
        </div>
        <div class="input-group my-3">
          <span class="input-group-text text-wrap col-4 col-sm-3">Länk till en bild</span>
          <input type="text" class="form-control col-8 col-sm-9" @bind="ImgUrlInput">
        </div>
        <div class="input-group my-3">
          <UploadFileComponent OnSetImageFile="(image) => UploadedImage = image" />
          @if (ImageId is not null || UploadedImage is not null)
          {
            <button class="btn btn-danger rounded w-100" @onclick="() => ImageId = null">
              Ta bort bilden
            </button>
          }
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" @onclick="OnCloseHandler">Avbryt</button>
        <button type="button" class="btn btn-primary" disabled="@_saving" @onclick="HandleOnSave">
          @(_saving ? "Ett ögonblick…" : "Spara")
        </button>
      </div>
    </div>
  </div>
</div>

@code
{
  [Parameter]
  public DishDto? Dish { get; set; }

  [Parameter]
  public Days Day { get; set; }

  [Parameter]
  public EventCallback<(DishDto, bool)> HandleOnSaveEvent { get; set; }

  [Parameter]
  public EventCallback<bool> OnCloseEvent { get; set; }

  /// <summary>Sätts av föräldern när sparningen nekats. Felet hör hemma där handlingen gjordes.</summary>
  [Parameter]
  public string? SaveError { get; set; }

  /// <summary>Hindrar dubbelklick på sparaknappen medan sparningen pågår.</summary>
  private bool _saving;

  /// <summary>
  /// Fel användaren själv kan åtgärda, visat vid fältet. Skilt från SaveError, som
  /// föräldern fyller med "försök igen" — den texten hör bara till tillfälliga fel.
  /// </summary>
  private string? _titleError;

  private string TitleInput { get; set; } = string.Empty;
  private string NotesTextArea { get; set; } = string.Empty;
  private string ImgUrlInput { get; set; } = string.Empty;
  private string RecipeUrlInput { get; set; } = string.Empty;
  /// <summary>
  /// Tom lista, inte null. EditOrCreateState fyller den bara i ändra-grenen, så i
  /// skapa-grenen gick null vidare till Dishes.Ingredients som är NOT NULL.
  /// </summary>
  public IList<string> IngredientList { get; set; } = new List<string>();
  public string ModalHeaderText { get; set; } = "Lägg till en rätt";

  private IBrowserFile? UploadedImage { get; set; }
  public string? ImageId { get; set; }


  protected override void OnInitialized()
  {
    EditOrCreateState();
  }

  private void EditOrCreateState()
  {
    if (Dish != null)
    {
      ModalHeaderText = $"Ändra {Dish.Title}";
      TitleInput = Dish.Title;
      NotesTextArea = Dish.Notes;
      ImgUrlInput = Dish.ImgUrl ?? string.Empty;
      RecipeUrlInput = Dish.RecipeUrl ?? string.Empty;
      IngredientList = Dish.Ingredients.Select(x => x).ToList();
      ImageId = Dish.ImageId;
    }
  }

  private void OnAddIngredientHandler(IList<string> ingredientList)
  {
    IngredientList = ingredientList;
  }

  private async Task OnCloseHandler()
  {
    IngredientList = Dish?.Ingredients.Select(x => x).ToList() ?? new List<string>();
    await OnCloseEvent.InvokeAsync(true);
  }
  /// <summary>
  /// Modalen stänger inte sig själv. Föräldern äger sparningen och stänger bara när den
  /// lyckades — annars står modalen kvar med felet i sig.
  /// </summary>
  private async Task HandleOnSave()
  {
    _saving = true;
    try
    {
      await SaveAsync();
    }
    finally
    {
      _saving = false;
    }
  }

  private async Task SaveAsync()
  {
    // Saknad titel fångas här, inte av databasen. Anropet till föräldern uteblir, så
    // modalen står kvar med allt användaren skrivit.
    _titleError = null;
    if (string.IsNullOrWhiteSpace(TitleInput))
    {
      _titleError = "Rätten behöver ett namn.";
      return;
    }

    if (Dish == null)
    {
      Dish = new DishDto
      {
        Title = TitleInput,
        Notes = NotesTextArea,
        ImgUrl = ImgUrlInput,
        RecipeUrl = RecipeUrlInput,
        Ingredients = IngredientList,
        Image = UploadedImage,
      };
      await HandleOnSaveEvent.InvokeAsync((Dish, true));
    }
    else
    {
      Dish.Title = TitleInput;
      Dish.Notes = NotesTextArea;
      Dish.ImgUrl = ImgUrlInput;
      Dish.RecipeUrl = RecipeUrlInput;
      Dish.Ingredients = IngredientList;
      Dish.Image = UploadedImage;
      Dish.ImageId = ImageId;
      await HandleOnSaveEvent.InvokeAsync((Dish, false));
    }
  }
}