@inject NavigationManager Navigation;
@inject IJSRuntime JS;

<nav class="navbar navbar-expand bg-light mb-3">
    <div class="app-shell">
        @* Match.All: annars matchar "/" varenda rutt och hemknappen vore alltid aktiv. *@
        <NavLink class="navbar-brand d-flex justify-items-center nav-link" href="/" Match="NavLinkMatch.All">
            <button class="btn btn-outline-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                    <use href="/svg/home.svg#icon-home"></use>
                </svg>
            </button>
        </NavLink>
        <ul class="navbar-nav w-100 justify-content-between">
            <li class="nav-item">
                <NavLink class="nav-link" href="previousDishes">
                    <button class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                            <use href="/svg/forkandknife.svg#icon-forkandknife"></use>
                        </svg>
                    </button>
                </NavLink>
            </li>
            <AuthorizeView Roles="admin">
                <li class="nav-item">
                    <NavLink class="nav-link" href="admin/anvandare">
                        <button class="btn btn-outline-secondary">Användare</button>
                    </NavLink>
                </li>
            </AuthorizeView>
            <AuthorizeView>
                <li class="nav-item">
                    @* Vanlig länk, inte NavLink: /konto är en Razor Page utanför Blazor-routern
                       och måste laddas som en hel sida. *@
                    <a class="nav-link" href="konto">
                        <button class="btn btn-outline-secondary">Mitt konto</button>
                    </a>
                </li>
                <li class="nav-item d-flex align-items-center">
                    <span class="text-muted">@context.User.Identity?.Name</span>
                </li>
            </AuthorizeView>
            <li class="nav-item d-flex align-items-center">
                <button class="btn btn-outline-secondary" @onclick="SignOut">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                        <use href="/svg/box-arrow-right.svg#box-arrow-right"></use>
                    </svg>
                </button>
            </li>
        </ul>
        @* </div> *@
    </div>
</nav>

@code
{
    private async Task SignOut()
    {
        // Cookien kan inte tas bort från en Blazor-krets, och utloggningen ligger bara
        // på POST. Knappen postar därför formuläret med antiforgery-token som ligger
        // i _Layout.
        await JS.InvokeVoidAsync("submitLogout");
    }

    private void ToPreviousDishes()
    {
        Navigation.NavigateTo("/previousDishes");
    }
}