@inject NavigationManager Navigation;

<nav class="navbar navbar-expand bg-light mb-3">
    <div class="container-fluid" style="max-width: 520px;">
        <NavLink class="navbar-brand d-flex justify-items-center nav-link" href="/" style="color: var(--bs-secondary);">
            <button class="btn btn-outline-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                    <use href="/svg/home.svg#icon-home"></use>
                </svg>
            </button>
        </NavLink>
        <ul class="navbar-nav w-100 justify-content-between">
            <li class="nav-item">
                <NavLink class="nav-link" style="color: var(--bs-secondary);" href="previousDishes">
                    <button class="btn btn-outline-secondary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                            <use href="/svg/forkandknife.svg#icon-forkandknife"></use>
                        </svg>
                    </button>
                </NavLink>
            </li>
            <AuthorizeView>
                <li class="nav-item d-flex align-items-center">
                    <span class="text-muted">@context.User.Identity?.Name</span>
                </li>
            </AuthorizeView>
            <li class="nav-item d-flex align-items-center">
                <button class="btn btn-outline-secondary" @onclick="SignOut">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                        <use href="/svg/box-arrow-right.svg#box-arrow-right"></use>
                    </svg>
                </button>
            </li>
        </ul>
        @* </div> *@
    </div>
</nav>

@code
{
    private void SignOut()
    {
        // Utloggningen måste gå via en riktig begäran: cookien kan inte tas bort
        // från en Blazor-krets, där svaret för länge sedan är skickat.
        Navigation.NavigateTo("/logout", forceLoad: true);
    }

    private void ToPreviousDishes()
    {
        Navigation.NavigateTo("/previousDishes");
    }
}